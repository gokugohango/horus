FROM archlinux:latest

ENV CARGO_HOME=/root/.cargo
ENV PATH="/root/.cargo/bin:${PATH}"

# -Syu, not -Sy: a partial upgrade against a stale image index is unsupported on
# Arch and fails with "could not satisfy dependencies". `cargo` is also dropped
# — it is provided by `rust`, and asking for both makes the transaction
# unsatisfiable.
RUN pacman -Syu --noconfirm \
    gcc pkg-config openssl systemd alsa-lib \
    clang git rust

WORKDIR /horus
COPY . .

RUN cargo build --no-default-features --release -p horus_core -p horus_types -p horus_sys -p horus_manager

CMD ["cargo", "test", "--no-default-features", "-p", "horus_sys", "--", "--test-threads=1"]
